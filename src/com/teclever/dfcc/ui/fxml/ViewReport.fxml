<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane fx:id="viewreport" prefHeight="329.0" prefWidth="710.0" stylesheets="@../css/ViewReport.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teclever.dfcc.Controller.ui.ViewReportController">
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="329.0" prefWidth="710.0" spacing="10.0">
         <children>
            <Label fx:id="headinglbl" prefHeight="36.0" prefWidth="200.0" text="VIEW REPORT" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <VBox alignment="CENTER_LEFT" prefHeight="207.0" prefWidth="670.0">
               <children>
                  <Label fx:id="labelEndRemarks" text="The report has been downloaded successfully. Would you like to view it now?" textFill="WHITE" wrapText="true">
                     <font>
                        <Font name="Arial" size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Label>
                  <TextArea fx:id="reportPath" editable="false" prefHeight="88.0" prefWidth="670.0" wrapText="true" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
            <HBox alignment="CENTER" prefHeight="73.0" prefWidth="300.0" spacing="110.0">
               <children>
                  <Button fx:id="viewButton" mnemonicParsing="false" text="View" />
                  <Button fx:id="cancelButton" mnemonicParsing="false" text="Cancel" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</Pane>
