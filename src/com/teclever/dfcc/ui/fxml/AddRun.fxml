<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane fx:id="addrun" prefHeight="400.0" prefWidth="400.0" stylesheets="@../css/AddRun.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teclever.dfcc.Controller.ui.AddRunConfigurationController">
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="400.0" spacing="20.0">
         <children>
            <Label fx:id="headinglbl" prefHeight="23.0" prefWidth="93.0" text="ADD RUN" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <VBox alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="380.0">
               <children>
                  <Label fx:id="labelAitessname" text="Select Test Type" textFill="WHITE">
                     <font>
                        <Font name="Arial" size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Label>
                  <ComboBox fx:id="testType" onAction="#testTypeAction" prefHeight="25.0" prefWidth="303.0" stylesheets="@../css/AddRun.css" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="380.0">
               <children>
                  <Label fx:id="labelAitessname1" text="Select AITESS Type" textFill="WHITE">
                     <font>
                        <Font name="Arial" size="16.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="aitessType" prefHeight="25.0" prefWidth="303.0" stylesheets="@../css/AddRun.css" />
               </children>
               <VBox.margin>
                  <Insets top="-5.0" />
               </VBox.margin>
            </VBox>
            <VBox fx:id="vBoxDriver" alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="380.0" stylesheets="@../css/AddRun.css">
               <VBox.margin>
                  <Insets top="3.0" />
               </VBox.margin></VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="380.0">
               <children>
                  <Button fx:id="selectConfigfile" mnemonicParsing="false" onAction="#selectConfigfileAction" prefHeight="25.0" prefWidth="380.0" stylesheets="@../css/AddRun.css" text="select Config File" textFill="WHITE" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
            <HBox prefHeight="73.0" prefWidth="300.0">
               <children>
                  <HBox fx:id="hboxSave" prefHeight="100.0" prefWidth="150.0">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin></HBox>
                  <HBox fx:id="hboxCancel" prefHeight="100.0" prefWidth="150.0">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin></HBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="50.0" right="50.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</Pane>
