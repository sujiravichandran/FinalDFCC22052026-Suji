<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane fx:id="addrun" prefHeight="557.0" prefWidth="412.0" stylesheets="@../css/AddRun.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teclever.dfcc.Controller.ui.AddRunConfigurationController">
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
   <children>
      <VBox alignment="CENTER" prefHeight="557.0" prefWidth="412.0" spacing="20.0">
         <children>
            <Label fx:id="headinglbl" alignment="CENTER" prefHeight="23.0" prefWidth="93.0" text="ADD RUN" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="23.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <VBox alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="380.0">
               <children>
                  <Label fx:id="labelAitessname" text="Select Test Type" textFill="WHITE">
                     <font>
                        <Font name="Arial" size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Label>
                  <ComboBox fx:id="testType" onAction="#testTypeAction" prefHeight="36.0" prefWidth="375.0" stylesheets="@../css/AddRun.css" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="380.0">
               <children>
                  <Label fx:id="labelAitessname1" text="Select AITESS Type" textFill="WHITE">
                     <font>
                        <Font name="Arial" size="16.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="aitessType" prefHeight="36.0" prefWidth="398.0" stylesheets="@../css/AddRun.css" />
               </children>
               <VBox.margin>
                  <Insets top="-5.0" />
               </VBox.margin>
            </VBox>
            <HBox fx:id="vBoxDriver1" alignment="CENTER" prefHeight="39.0" prefWidth="316.0" />
            <VBox alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="280.0">
               <children>
                  <Button fx:id="selectConfigfile1" mnemonicParsing="false" onAction="#selectConfigfileAction1" prefHeight="42.0" prefWidth="375.0" stylesheets="@../css/AddRun.css" text="Select Aitess1 Config File" textFill="WHITE" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
            <Button fx:id="selectConfigfile2" mnemonicParsing="false" onAction="#selectConfigfileAction2" prefHeight="42.0" prefWidth="375.0" stylesheets="@../css/AddRun.css" text="Select Aitess2 Config File" textFill="WHITE" />
            <HBox prefHeight="42.0" prefWidth="312.0" spacing="71.0">
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" text="Save" />
                  <Button fx:id="cancelButton" minWidth="125.0" mnemonicParsing="false" prefHeight="39.0" prefWidth="125.0" text="Close">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</Pane>
